set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)

set(XIAOCAI_TOOLCHAIN_ROOT "/opt/gcc-arm-10.3-2021.07-x86_64-aarch64-none-linux-gnu" CACHE PATH "AArch64 GCC toolchain root")
if(NOT DEFINED XIAOCAI_SYSROOT OR XIAOCAI_SYSROOT STREQUAL "")
  message(FATAL_ERROR "Set XIAOCAI_SYSROOT to the RK3566 sysroot before cross-compiling.")
endif()

set(CMAKE_C_COMPILER "${XIAOCAI_TOOLCHAIN_ROOT}/bin/aarch64-none-linux-gnu-gcc")
set(CMAKE_CXX_COMPILER "${XIAOCAI_TOOLCHAIN_ROOT}/bin/aarch64-none-linux-gnu-g++")
set(CMAKE_SYSROOT "${XIAOCAI_SYSROOT}")
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES XIAOCAI_SYSROOT XIAOCAI_TOOLCHAIN_ROOT)

set(XIAOCAI_MULTIARCH_LIB "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu")
set(CMAKE_C_FLAGS_INIT "-B${XIAOCAI_MULTIARCH_LIB} -isystem ${CMAKE_SYSROOT}/usr/include/aarch64-linux-gnu")
set(CMAKE_CXX_FLAGS_INIT "-B${XIAOCAI_MULTIARCH_LIB} -isystem ${CMAKE_SYSROOT}/usr/include/aarch64-linux-gnu")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-B${XIAOCAI_MULTIARCH_LIB} -L${XIAOCAI_MULTIARCH_LIB} -Wl,-rpath-link,${XIAOCAI_MULTIARCH_LIB}")

set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_PREFIX_PATH "${CMAKE_SYSROOT}/opt/ros/humble")
set(Python3_EXECUTABLE "/usr/bin/python3" CACHE FILEPATH "Host Python interpreter")

set(OPENSSL_ROOT_DIR "${CMAKE_SYSROOT}/usr" CACHE PATH "Target OpenSSL root" FORCE)
set(OPENSSL_INCLUDE_DIR "${CMAKE_SYSROOT}/usr/include" CACHE PATH "Target OpenSSL headers" FORCE)
set(OPENSSL_CRYPTO_LIBRARY "${XIAOCAI_MULTIARCH_LIB}/libcrypto.so" CACHE FILEPATH "Target libcrypto" FORCE)
set(OPENSSL_SSL_LIBRARY "${XIAOCAI_MULTIARCH_LIB}/libssl.so" CACHE FILEPATH "Target libssl" FORCE)
set(spdlog_DIR "${XIAOCAI_MULTIARCH_LIB}/cmake/spdlog" CACHE PATH "Target spdlog CMake package" FORCE)
set(fmt_DIR "${XIAOCAI_MULTIARCH_LIB}/cmake/fmt" CACHE PATH "Target fmt CMake package" FORCE)
set(CMAKE_SKIP_RPATH TRUE)
